<!--
    fragment_home.xml — SmartTour360 Home Dashboard
    ═══════════════════════════════════════════════
    Structure:
      Header (always visible)
      Search bar (always visible)
      Category pills (always visible)
      ─── content switcher ───
      homeSection   (VISIBLE when All/Adventure/Beaches selected)
