<?xml version="1.0" encoding="utf-8"?>
<!--
    SmartTour360 Driver App - Apply For Leave Fragment
    Sky/travel background + white card + date pickers + Apply button.
    All view IDs preserved from the original so DriverLeaveFragment.java
    works without any changes.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_leave_screen"
    tools:context=".driver.driver_fragments.DriverLeaveFragment">

    <!-- ══ HEADER: back arrow + title + airplane decoration ══ -->
    <LinearLayout
        android:id="@+id/ll_leave_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_leave_back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:contentDescription="@string/cd_back_arrow"
            android:focusable="true"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/leave_title" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="@string/leave_screen_title"
            android:textColor="@color/leave_title"
            android:textSize="@dimen/leave_title_size"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_airplane" />

    </LinearLayout>

    <!-- ══ APPLY BUTTON (fixed at bottom) ══ -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/driverApplyLeaveBtn"
        android:layout_width="0dp"
        android:layout_height="@dimen/leave_btn_height"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_leave_apply_btn"
        android:elevation="4dp"
        android:stateListAnimator="@null"
        android:text="@string/leave_btn_apply"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ══ MAIN FORM CARD (scrollable) ══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="false"
        app:layout_constraintBottom_toTopOf="@+id/driverApplyLeaveBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_leave_header">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/leave_card_bg"
            app:cardCornerRadius="@dimen/leave_card_corner"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- START DATE LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/leave_start_date_label"
                    android:textColor="@color/leave_label"
                    android:textSize="@dimen/leave_label_size"
                    android:textStyle="bold" />

                <!-- START DATE FIELD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/leave_field_height"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_leave_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="@dimen/leave_icon_size"
                        android:layout_height="@dimen/leave_icon_size"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/leave_icon" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/driverLeaveStartDate"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="@string/leave_hint_start_date"
                        android:inputType="none"
                        android:textColor="@color/leave_field_text"
                        android:textColorHint="@color/leave_field_hint"
                        android:textSize="@dimen/leave_field_text_size" />

                </LinearLayout>

                <!-- END DATE LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/leave_end_date_label"
                    android:textColor="@color/leave_label"
                    android:textSize="@dimen/leave_label_size"
                    android:textStyle="bold" />

                <!-- END DATE FIELD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/leave_field_height"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_leave_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="@dimen/leave_icon_size"
                        android:layout_height="@dimen/leave_icon_size"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/leave_icon" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/driverLeaveEndDate"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="@string/leave_hint_end_date"
                        android:inputType="none"
                        android:textColor="@color/leave_field_text"
                        android:textColorHint="@color/leave_field_hint"
                        android:textSize="@dimen/leave_field_text_size" />

                </LinearLayout>

                <!-- SUBJECT LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/leave_subject_label"
                    android:textColor="@color/leave_label"
                    android:textSize="@dimen/leave_label_size"
                    android:textStyle="bold" />

                <!-- SUBJECT FIELD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/leave_field_height"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_leave_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="@dimen/leave_icon_size"
                        android:layout_height="@dimen/leave_icon_size"
                        android:src="@drawable/ic_document"
                        app:tint="@color/leave_icon" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/driverLeaveSubject"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:hint="@string/leave_hint_subject"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:textColor="@color/leave_field_text"
                        android:textColorHint="@color/leave_field_hint"
                        android:textSize="@dimen/leave_field_text_size" />

                </LinearLayout>

                <!-- DESCRIPTION LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/leave_description_label"
                    android:textColor="@color/leave_label"
                    android:textSize="@dimen/leave_label_size"
                    android:textStyle="bold" />

                <!-- DESCRIPTION FIELD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/leave_desc_height"
                    android:background="@drawable/bg_leave_input_field"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="@dimen/leave_icon_size"
                        android:layout_height="@dimen/leave_icon_size"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_document"
                        app:tint="@color/leave_icon" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/driverLeaveDescription"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:gravity="top|start"
                        android:hint="@string/leave_hint_description"
                        android:inputType="textCapSentences|textMultiLine"
                        android:textColor="@color/leave_field_text"
                        android:textColorHint="@color/leave_field_hint"
                        android:textSize="@dimen/leave_field_text_size" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>