<?xml version="1.0" encoding="utf-8"?>
<!--
    Customer Login Screen — SmartTour360
    Existing view IDs preserved for Login.java:
      userLoginEmail  userLoginPassword  userLoginBtn
      cancelBtn (mapped to Guest)  regPageLink
    New IDs added (wired in updated Login.java):
      forgotPasswordLink  rememberMeCheck
      googleLoginBtn  guestLoginBtn
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".user.user_activities.Login">

    <!-- LAYER 1: Full-screen scenic background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_screen_bg"
        android:contentDescription="@null" />

    <!-- LAYER 2: Scrollable content over background -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Logo + tagline -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="52dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="68dp"
                    android:src="@drawable/ic_smarttour_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="SmartTour360 logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SmartTour360"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#0B3B78"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_tagline"
                    android:textSize="12sp"
                    android:textColor="#52739D"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- White login card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/login_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp">

                    <!-- Welcome title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_welcome_title"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/login_dark_text"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_welcome_subtitle"
                        android:textSize="14sp"
                        android:textColor="@color/login_secondary_text"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp" />

                    <!-- Email input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/login_input_shape"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_mail"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/userLoginEmail"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/login_email_hint"
                            android:inputType="textEmailAddress"
                            android:textSize="15sp"
                            android:textColor="@color/login_dark_text"
                            android:textColorHint="@color/login_hint_text"
                            android:singleLine="true" />

                    </LinearLayout>

                    <!-- Password input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/login_input_shape"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_password"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/userLoginPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/login_password_hint"
                            android:inputType="textPassword"
                            android:textSize="15sp"
                            android:textColor="@color/login_dark_text"
                            android:textColorHint="@color/login_hint_text"
                            android:singleLine="true" />

                        <ImageView
                            android:id="@+id/passwordToggleIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_eye_off"
                            android:contentDescription="Toggle password visibility"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="2dp" />

                    </LinearLayout>

                    <!-- Remember me + Forgot Password row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <CheckBox
                            android:id="@+id/rememberMeCheck"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login_remember_me"
                            android:textSize="13sp"
                            android:textColor="@color/login_secondary_text"
                            android:buttonTint="@color/login_primary_blue" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/forgotPasswordLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login_forgot_password"
                            android:textSize="13sp"
                            android:textColor="@color/login_forgot_blue"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- Login button (existing ID: userLoginBtn) -->
                    <Button
                        android:id="@+id/userLoginBtn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Login"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/login_btn_primary"
                        android:stateListAnimator="@null"
                        android:layout_marginBottom="20dp"
                        tools:ignore="HardcodedText" />

                    <!-- OR divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#C5DCF5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login_or_divider"
                            android:textSize="13sp"
                            android:textColor="@color/login_secondary_text"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#C5DCF5" />

                    </LinearLayout>

                    <!-- Continue with Google -->
                    <LinearLayout
                        android:id="@+id/googleLoginBtn"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/login_outline_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="20dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_google"
                            android:contentDescription="Google logo"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login_google_btn"
                            android:textSize="15sp"
                            android:textColor="@color/login_dark_text"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <!-- Register link -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login_no_account"
                            android:textSize="14sp"
                            android:textColor="@color/login_secondary_text" />

                        <TextView
                            android:id="@+id/regPageLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/login_register_link"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/login_bright_blue"
                            android:paddingStart="4dp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Continue as Guest pill — below the card -->
            <LinearLayout
                android:id="@+id/guestLoginBtn"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/login_guest_btn"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_profile"
                    android:contentDescription="@null"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_guest_btn"
                    android:textSize="14sp"
                    android:textColor="@color/login_primary_blue"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>