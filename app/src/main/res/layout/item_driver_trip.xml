<?xml version="1.0" encoding="utf-8"?>
<!--
    SmartTour360 Driver App — Schedule Screen
    Single trip card item used by DriverTripAdapter in RecyclerView.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/sched_card_bg"
    app:cardCornerRadius="@dimen/sched_card_corner"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/sched_card_padding">

        <!-- ── Row 1: Time + Status Badge ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_trip_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="10:30 AM"
                android:textColor="@color/sched_time_text"
                android:textSize="@dimen/sched_time_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_trip_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sched_badge_ongoing"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="@string/sched_badge_ongoing"
                android:textColor="@color/sched_badge_ongoing_text"
                android:textSize="@dimen/sched_badge_size"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ── Row 2: Route (pickup → destination) + chevron ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Dot + line + pin column -->
            <LinearLayout
                android:layout_width="16dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp">

                <!-- Blue filled dot (pickup) -->
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_location_dot" />

                <!-- Dotted line -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_route_line" />

                <!-- Blue pin dot (destination) -->
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location_pin_green"
                    app:tint="@color/sched_tab_selected_bg" />

            </LinearLayout>

            <!-- Location texts -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_trip_pickup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pune Airport"
                    android:textColor="@color/sched_location_text"
                    android:textSize="@dimen/sched_location_size" />

                <TextView
                    android:id="@+id/tv_trip_destination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Lonavala, Maharashtra"
                    android:textColor="@color/sched_location_text"
                    android:textSize="@dimen/sched_location_size" />

            </LinearLayout>

            <!-- Chevron arrow -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right" />

        </LinearLayout>

        <!-- ── Divider ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@color/sched_divider" />

        <!-- ── Row 3: Meta info (seats · fare · distance) ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_car"
                app:tint="@color/sched_tab_selected_bg" />

            <TextView
                android:id="@+id/tv_trip_seats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="2 Seats"
                android:textColor="@color/sched_meta_text"
                android:textSize="@dimen/sched_meta_size" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:text="•"
                android:textColor="@color/sched_meta_text" />

            <TextView
                android:id="@+id/tv_trip_fare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ 650"
                android:textColor="@color/sched_meta_text"
                android:textSize="@dimen/sched_meta_size" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:text="•"
                android:textColor="@color/sched_meta_text" />

            <TextView
                android:id="@+id/tv_trip_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45 km"
                android:textColor="@color/sched_meta_text"
                android:textSize="@dimen/sched_meta_size" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>