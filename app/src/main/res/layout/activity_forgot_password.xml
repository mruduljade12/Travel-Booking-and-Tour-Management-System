<?xml version="1.0" encoding="utf-8"?>
<!--
    Forgot Password Screen — SmartTour360
    Reuses existing resources: splash_screen_bg, ic_smarttour_logo,
    ic_mail, login_btn_primary, login_card_bg, login_input_shape,
    login_* colors. No duplicate resources created.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".user.user_activities.ForgotPassword">

    <!-- Layer 1: Full-screen scenic background (reused from Login/Splash) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_screen_bg"
        android:contentDescription="@null" />

    <!-- Layer 2: Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- SmartTour360 brand header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="52dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_smarttour_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="SmartTour360 logo" />

                <!-- Two-tone brand name rendered in Java via SpannableString -->
                <TextView
                    android:id="@+id/fpBrandName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SmartTour360"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/login_dark_text"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="6dp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explore  &#8226;  Book  &#8226;  Travel  &#8226;  Live"
                    android:textSize="12sp"
                    android:textColor="@color/login_secondary_text"
                    android:layout_marginTop="2dp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- Forgot Password card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/login_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="30dp"
                    android:paddingBottom="30dp">

                    <!-- Title: Forgot Password? -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fp_title"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/login_dark_text"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:layout_marginBottom="10dp" />

                    <!-- Description -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fp_desc"
                        android:textSize="14sp"
                        android:textColor="@color/login_secondary_text"
                        android:lineSpacingMultiplier="1.45"
                        android:layout_marginBottom="22dp" />

                    <!-- Email / Phone input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/login_input_shape"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="18dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_mail"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/fpEmailInput"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/fp_input_hint"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionDone"
                            android:textSize="15sp"
                            android:textColor="@color/login_dark_text"
                            android:textColorHint="@color/login_hint_text"
                            android:singleLine="true" />

                    </LinearLayout>

                    <!-- Send Reset Link button -->
                    <Button
                        android:id="@+id/fpSendBtn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/fp_btn_send"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/login_btn_primary"
                        android:stateListAnimator="@null"
                        android:layout_marginBottom="20dp" />

                    <!-- Remember password / Login link -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fp_remember_pwd"
                            android:textSize="14sp"
                            android:textColor="@color/login_secondary_text" />

                        <TextView
                            android:id="@+id/fpLoginLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fp_login_link"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/login_bright_blue"
                            android:paddingStart="4dp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</FrameLayout>