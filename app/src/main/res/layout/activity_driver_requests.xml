<?xml version="1.0" encoding="utf-8"?>
<!--
    SmartTour360 Driver App — Screen 5: Driver Requests
    ConstraintLayout root → Header + Tabs + RecyclerView + BottomNav
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/req_bg"
    tools:context=".driver.driver_activities.DriverRequestsActivity">

    <!-- ══════════════════════════════════════
         HEADER
    ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/ll_req_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_req_back"
            android:layout_width="@dimen/req_header_icon_size"
            android:layout_height="@dimen/req_header_icon_size"
            android:clickable="true"
            android:contentDescription="@string/cd_back_arrow"
            android:focusable="true"
            android:padding="2dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/req_header_title" />

        <TextView
            android:id="@+id/tv_req_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="@string/req_screen_title"
            android:textColor="@color/req_header_title"
            android:textSize="@dimen/req_header_title_size"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_req_filter"
            android:layout_width="@dimen/req_header_icon_size"
            android:layout_height="@dimen/req_header_icon_size"
            android:clickable="true"
            android:contentDescription="@string/cd_filter_icon"
            android:focusable="true"
            android:src="@drawable/ic_filter" />

    </LinearLayout>

    <!-- ══════════════════════════════════════
         TAB ROW — All / Pending / Accepted
    ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/ll_req_tabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_req_header">

        <TextView
            android:id="@+id/tab_all"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:text="@string/req_tab_all"
            android:textColor="@color/req_tab_selected_text"
            android:textSize="@dimen/req_tab_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_pending"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_unselected"
            android:gravity="center"
            android:text="@string/req_tab_pending"
            android:textColor="@color/req_tab_unselected_text"
            android:textSize="@dimen/req_tab_text_size" />

        <TextView
            android:id="@+id/tab_accepted"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_unselected"
            android:gravity="center"
            android:text="@string/req_tab_accepted"
            android:textColor="@color/req_tab_unselected_text"
            android:textSize="@dimen/req_tab_text_size" />

    </LinearLayout>

    <!-- ══════════════════════════════════════
         BOTTOM NAVIGATION
    ══════════════════════════════════════ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/req_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/home_card_bg"
        app:itemIconTint="@color/home_nav_unselected"
        app:itemTextColor="@color/home_nav_unselected"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/driver_menu" />

    <!-- ══════════════════════════════════════
         REQUEST LIST
    ══════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_driver_requests"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/req_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_req_tabs" />

</androidx.constraintlayout.widget.ConstraintLayout>