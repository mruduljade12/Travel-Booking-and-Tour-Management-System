<?xml version="1.0" encoding="utf-8"?>
<!--
    Search Packages screen — fragment_search.xml
    Existing IDs preserved: etSearchTourQuery, rvSearchTourList
    New IDs: searchBanner, searchFilterCard, searchDestRow,
             searchCheckinRow, searchCheckoutRow, searchTravellersRow,
             btnSearchPackages, tvSearchDest, tvCheckinDate, tvCheckoutDate,
             tvTravellers, rvPopularPackages
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/search_screen_bg"
    android:fillViewport="true"
    tools:context=".user.user_fragments.SearchFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ═══ HEADER ═══════════════════════════════════════════════ -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/searchHamburger"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_menu_hamburger"
                android:contentDescription="Menu"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_smarttour_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="SmartTour360 logo"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SmartTour360"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#0D5BB5"
                    android:fontFamily="sans-serif-medium"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/searchNotifContainer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notification"
                    android:contentDescription="Notifications" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/home_notif_dot" />

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ═══ HERO BANNER ══════════════════════════════════════════ -->
        <FrameLayout
            android:id="@+id/searchBanner"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/search_banner_bg"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/splash_screen_bg"
                android:contentDescription="@null" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/search_banner_overlay" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search_pkg_banner_title"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="2.5dp"
                    android:background="#5BD0FF"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_pkg_banner_subtitle"
                    android:textSize="13sp"
                    android:textColor="#DDFFFFFF"
                    android:lineSpacingMultiplier="1.35" />

            </LinearLayout>

        </FrameLayout>

        <!-- ═══ SEARCH FILTER CARD ══════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/searchFilterCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- DESTINATION ROW -->
                <LinearLayout
                    android:id="@+id/searchDestRow"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_address"
                        android:contentDescription="@null"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_destination_label"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0D5BB5" />

                        <TextView
                            android:id="@+id/tvSearchDest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_destination_hint"
                            android:textSize="12sp"
                            android:textColor="#8AAAC8"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null" />

                </LinearLayout>

                <!-- DIVIDER -->
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#EAF3FA"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp" />

                <!-- CHECK-IN / CHECK-OUT row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <!-- CHECK-IN -->
                    <LinearLayout
                        android:id="@+id/searchCheckinRow"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_calendar"
                            android:contentDescription="@null"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/search_checkin_label"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#0D5BB5" />

                            <TextView
                                android:id="@+id/tvCheckinDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/search_date_hint"
                                android:textSize="12sp"
                                android:textColor="#8AAAC8"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@null" />

                    </LinearLayout>

                    <!-- Vertical separator -->
                    <View android:layout_width="1dp" android:layout_height="match_parent"
                        android:background="#EAF3FA"
                        android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />

                    <!-- CHECK-OUT -->
                    <LinearLayout
                        android:id="@+id/searchCheckoutRow"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_calendar"
                            android:contentDescription="@null"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/search_checkout_label"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#0D5BB5" />

                            <TextView
                                android:id="@+id/tvCheckoutDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/search_date_hint"
                                android:textSize="12sp"
                                android:textColor="#8AAAC8"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@null" />

                    </LinearLayout>

                </LinearLayout>

                <!-- DIVIDER -->
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#EAF3FA"
                    android:layout_marginStart="16dp" android:layout_marginEnd="16dp" />

                <!-- TRAVELLERS ROW -->
                <LinearLayout
                    android:id="@+id/searchTravellersRow"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_groups"
                        android:contentDescription="@null"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_travellers_label"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0D5BB5" />

                        <TextView
                            android:id="@+id/tvTravellers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/search_travellers_default"
                            android:textSize="12sp"
                            android:textColor="#8AAAC8"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@null" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══ SEARCH BUTTON ════════════════════════════════════════ -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSearchPackages"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/search_btn_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/search_btn_bg"
            android:stateListAnimator="@null"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp" />

        <!-- ═══ POPULAR PACKAGES HEADER ═════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_package"
                android:contentDescription="@null"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/search_popular_title"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0D5BB5" />

            <TextView
                android:id="@+id/tvViewAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_view_all"
                android:textSize="13sp"
                android:textColor="#1899E8"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null" />

        </LinearLayout>

        <!-- ═══ POPULAR PACKAGES RecyclerView ═══════════════════════ -->
        <!-- rvSearchTourList ID preserved for existing code compat -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchTourList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_popular_package" />

        <!-- Empty state (hidden by default) -->
        <LinearLayout
            android:id="@+id/layoutSearchEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_default_image"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_no_results"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0D5BB5"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_no_results_sub"
                android:textSize="13sp"
                android:textColor="#8AAAC8"
                android:layout_marginTop="6dp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>