<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".app_common_activities.SplashScreen">

    <!-- ── LAYER 1: Full-screen scenic background ── -->
    <ImageView
        android:id="@+id/iv_splash_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/cd_splash_bg"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_screen_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ── LAYER 2: White gradient overlay (transparent→white, top→bottom)
             keeps lower-half content readable over the bright sky image ── -->
    <View
        android:id="@+id/v_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_driver_splash_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ══════════════════════════════════════════════
         BRAND CARD  —  upper-centre
         Logo  ▸  SmartTour360  ▸  tagline
    ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/ll_brand_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:background="@drawable/driver_splash_brand_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/splash_card_padding_h"
        android:paddingTop="@dimen/splash_card_padding_v"
        android:paddingEnd="@dimen/splash_card_padding_h"
        android:paddingBottom="@dimen/splash_card_padding_v"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo -->
        <ImageView
            android:id="@+id/iv_brand_logo"
            android:layout_width="@dimen/splash_brand_logo_size"
            android:layout_height="@dimen/splash_brand_logo_size"
            android:contentDescription="@string/cd_brand_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/tour_travel_logo" />

        <!-- SmartTour360 -->
        <TextView
            android:id="@+id/tv_brand_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/smarttour360"
            android:textColor="@color/driver_splash_brand_text"
            android:textSize="@dimen/splash_brand_text_size"
            android:textStyle="bold" />

        <!-- Explore • Book • Travel • Live -->
        <TextView
            android:id="@+id/tv_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.03"
            android:text="@string/driver_splash_tagline"
            android:textColor="@color/driver_splash_subtitle_text"
            android:textSize="@dimen/splash_tagline_text_size" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════
         MAIN HEADING  —  "Driver App"
    ══════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tv_driver_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/driver_app_title"
        android:textColor="@color/driver_splash_title_text"
        android:textSize="@dimen/splash_title_text_size"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_brand_section" />

    <!-- ══════════════════════════════════════════════
         SUBTITLE  —  "Your journey keeps…"
    ══════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tv_driver_app_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/driver_app_subtitle"
        android:textColor="@color/driver_splash_subtitle_text"
        android:textSize="@dimen/splash_subtitle_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_driver_app_title" />

    <!-- ══════════════════════════════════════════════
         DRIVER ILLUSTRATION  —  lower-middle
         (replace src with ic_driver_splash_illustration
          once the asset is added to res/drawable)
    ══════════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/iv_driver_illustration"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/cd_driver_illustration"
        android:scaleType="fitCenter"
        android:src="@drawable/driver_ic"
        app:layout_constraintBottom_toTopOf="@+id/btn_get_started"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_driver_app_subtitle"
        app:layout_constraintVertical_bias="0.5" />

    <!-- ══════════════════════════════════════════════
         PRIMARY CTA  —  "Let's Get Started →"
    ══════════════════════════════════════════════ -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_get_started"
        android:layout_width="0dp"
        android:layout_height="@dimen/splash_btn_height"
        android:layout_marginStart="@dimen/splash_btn_margin_h"
        android:layout_marginEnd="@dimen/splash_btn_margin_h"
        android:layout_marginBottom="12dp"
        android:background="@drawable/btn_driver_splash_cta"
        android:elevation="6dp"
        android:stateListAnimator="@null"
        android:text="@string/btn_get_started"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/ll_bottom_links"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ══════════════════════════════════════════════
         BOTTOM LINKS  —  "Driver Login | Register"
    ══════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/ll_bottom_links"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_driver_login_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="@string/lbl_driver_login"
            android:textColor="@color/driver_splash_bottom_link"
            android:textSize="@dimen/splash_bottom_text_size"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:text=" | "
            android:textColor="@color/driver_splash_divider"
            android:textSize="@dimen/splash_bottom_text_size" />

        <TextView
            android:id="@+id/tv_register_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="@string/lbl_register"
            android:textColor="@color/driver_splash_bottom_link"
            android:textSize="@dimen/splash_bottom_text_size"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>