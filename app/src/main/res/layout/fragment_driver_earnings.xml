<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/earn_bg"
    android:fillViewport="true"
    tools:context=".driver.driver_fragments.DriverEarningsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/cd_earn_wallet"
                android:src="@drawable/ic_wallet"
                app:tint="@color/earn_title" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/earn_screen_title"
                android:textColor="@color/earn_title"
                android:textSize="@dimen/earn_title_size"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TOTAL EARNINGS CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_earn_total_card"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">
                <LinearLayout
                    android:id="@+id/ll_total_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_earn_wallet_large"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/earn_total_label"
                            android:textColor="@color/earn_total_text"
                            android:textSize="@dimen/earn_total_label_size" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_arrow_down_white" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-black"
                        android:id="@+id/tv_earn_total_amount"
                        android:text="@string/earn_total_amount"
                        android:textColor="@color/earn_total_text"
                        android:textSize="@dimen/earn_total_amount_size"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:id="@+id/tv_earn_total_period"
                        android:text="@string/earn_total_period"
                        android:textColor="@color/earn_total_sub"
                        android:textSize="@dimen/earn_total_period_size" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/iv_earn_wallet_large"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/cd_earn_wallet"
                    android:src="@drawable/ic_wallet_white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- STATISTICS ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:weightSum="2">
            <!-- Completed Trips -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/earn_card_bg"
                app:cardCornerRadius="@dimen/earn_card_corner"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/earn_card_padding">
                    <FrameLayout
                        android:layout_width="@dimen/earn_stat_icon_size"
                        android:layout_height="@dimen/earn_stat_icon_size"
                        android:background="@drawable/bg_circle_earn_trips">
                        <ImageView
                            android:layout_width="@dimen/earn_stat_icon_inner"
                            android:layout_height="@dimen/earn_stat_icon_inner"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_earn_trips_icon"
                            android:src="@drawable/ic_car"
                            app:tint="@color/earn_stat_trips_icon" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/earn_completed_trips"
                            android:textColor="@color/earn_stat_label"
                            android:textSize="@dimen/earn_stat_label_size" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/earn_trips_count"
                            android:textColor="@color/earn_stat_value"
                            android:textSize="@dimen/earn_stat_value_size"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- Average per Trip -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/earn_card_bg"
                app:cardCornerRadius="@dimen/earn_card_corner"
                app:cardElevation="3dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/earn_card_padding">
                    <FrameLayout
                        android:layout_width="@dimen/earn_stat_icon_size"
                        android:layout_height="@dimen/earn_stat_icon_size"
                        android:background="@drawable/bg_circle_earn_avg">
                        <ImageView
                            android:layout_width="@dimen/earn_stat_icon_inner"
                            android:layout_height="@dimen/earn_stat_icon_inner"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_earn_avg_icon"
                            android:src="@drawable/ic_rupee_purple" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/earn_avg_per_trip"
                            android:textColor="@color/earn_stat_label"
                            android:textSize="@dimen/earn_stat_label_size" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/earn_avg_amount"
                            android:textColor="@color/earn_stat_value"
                            android:textSize="@dimen/earn_stat_value_size"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- EARNINGS SUMMARY CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/earn_card_bg"
            app:cardCornerRadius="@dimen/earn_card_corner"
            app:cardElevation="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/earn_card_padding">

                <!-- Header row: title + 4-pill toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/earn_summary_title"
                        android:textColor="@color/earn_summary_title"
                        android:textSize="@dimen/earn_summary_title_size"
                        android:textStyle="bold" />

                    <!-- 4-pill period toggle -->
                    <LinearLayout
                        android:id="@+id/ll_period_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/bg_earn_toggle_container"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <TextView
                            android:id="@+id/toggle_today"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:text="@string/earn_period_today"
                            android:textColor="@color/earn_toggle_unselected_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/toggle_week"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_earn_toggle_selected"
                            android:gravity="center"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:text="@string/earn_period_week"
                            android:textColor="@color/earn_toggle_selected_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/toggle_month"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:text="@string/earn_period_month"
                            android:textColor="@color/earn_toggle_unselected_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/toggle_year"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:text="@string/earn_period_year"
                            android:textColor="@color/earn_toggle_unselected_text"
                            android:textSize="11sp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Bar chart -->
                <com.mrudul.tourandtravel.driver.driver_fragments.DriverBarChartView
                    android:id="@+id/bar_chart"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/earn_chart_height"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>