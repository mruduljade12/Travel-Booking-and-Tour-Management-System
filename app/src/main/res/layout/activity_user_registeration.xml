<?xml version="1.0" encoding="utf-8"?>
<!--
    Registration Screen — SmartTour360
    Existing IDs preserved for UserRegisteration.java:
      etName  etEmail  etPhone  etAddress  etPassword
      rgGender  rbMale  rbFemale  btnRegister  btnCancel  goToLogin
    New IDs added:
      regEmailMobile  regPasswordToggle  regConfirmPassword
      regConfirmToggle  regTermsCheck  regLoginLink
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".user.user_activities.UserRegisteration">

    <!-- Layer 1: Full-screen background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_screen_bg"
        android:contentDescription="@null" />

    <!-- Layer 2: Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Brand header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_smarttour_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="SmartTour360 logo" />

                <TextView
                    android:id="@+id/regBrandName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SmartTour360"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/login_dark_text"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="6dp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explore  &#8226;  Book  &#8226;  Travel  &#8226;  Live"
                    android:textSize="12sp"
                    android:textColor="@color/login_secondary_text"
                    android:layout_marginTop="2dp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- Registration card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/login_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reg_create_account"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="@color/login_dark_text"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:layout_marginBottom="6dp" />

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reg_subtitle"
                        android:textSize="14sp"
                        android:textColor="@color/login_secondary_text"
                        android:lineSpacingMultiplier="1.4"
                        android:layout_marginBottom="20dp" />

                    <!-- Field 1: Full Name (existing ID: etName) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/login_input_shape"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/etName"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/reg_full_name_hint"
                            android:inputType="textPersonName"
                            android:maxLength="40"
                            android:textSize="15sp"
                            android:textColor="@color/login_dark_text"
                            android:textColorHint="@color/login_hint_text"
                            android:singleLine="true" />

                    </LinearLayout>

                    <!-- Field 2: Email or Mobile (new combined field, existing etEmail preserved separately for API) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/login_input_shape"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_mail"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/regEmailMobile"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/reg_email_mobile_hint"
                            android:inputType="textEmailAddress"
                            android:maxLength="50"
                            android:textSize="15sp"
                            android:textColor="@color/login_dark_text"
                            android:textColorHint="@color/login_hint_text"
                            android:singleLine="true" />

                    </LinearLayout>

                    <!-- Field 3: Password (existing ID: etPassword) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/login_input_shape"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_password"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/reg_password_hint"
                            android:inputType="textPassword"
                            android:maxLength="30"
                            android:textSize="15sp"
                            android:textColor="@color/login_dark_text"
                            android:textColorHint="@color/login_hint_text"
                            android:singleLine="true" />

                        <ImageView
                            android:id="@+id/regPasswordToggle"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_eye_off"
                            android:contentDescription="Toggle password visibility"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="2dp" />

                    </LinearLayout>

                    <!-- Field 4: Confirm Password -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/login_input_shape"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_password"
                            android:contentDescription="@null"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/regConfirmPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/reg_confirm_hint"
                            android:inputType="textPassword"
                            android:maxLength="30"
                            android:textSize="15sp"
                            android:textColor="@color/login_dark_text"
                            android:textColorHint="@color/login_hint_text"
                            android:singleLine="true" />

                        <ImageView
                            android:id="@+id/regConfirmToggle"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_eye_off"
                            android:contentDescription="Toggle confirm password visibility"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="2dp" />

                    </LinearLayout>

                    <!-- Terms checkbox -->
                    <CheckBox
                        android:id="@+id/regTermsCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reg_terms"
                        android:textSize="13sp"
                        android:textColor="@color/login_secondary_text"
                        android:buttonTint="@color/login_primary_blue"
                        android:checked="true"
                        android:layout_marginBottom="18dp" />

                    <!-- Register button (existing ID: btnRegister) -->
                    <Button
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/reg_btn"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/login_btn_primary"
                        android:stateListAnimator="@null"
                        android:layout_marginBottom="18dp" />

                    <!-- Already have account / Login link -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reg_have_account"
                            android:textSize="14sp"
                            android:textColor="@color/login_secondary_text" />

                        <TextView
                            android:id="@+id/regLoginLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reg_login_link"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/login_bright_blue"
                            android:paddingStart="4dp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                    <!-- Hidden legacy views — kept so Java does not crash on findViewById -->
                    <!-- These are not displayed but preserve backward-compat with existing Java refs -->
                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        android:importantForAccessibility="no"
                        tools:ignore="HardcodedText" />

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        android:importantForAccessibility="no"
                        tools:ignore="HardcodedText" />

                    <EditText
                        android:id="@+id/etAddress"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone"
                        android:importantForAccessibility="no"
                        tools:ignore="HardcodedText" />

                    <RadioGroup
                        android:id="@+id/rgGender"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone">

                        <RadioButton android:id="@+id/rbMale"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />

                        <RadioButton android:id="@+id/rbFemale"
                            android:layout_width="0dp"
                            android:layout_height="0dp" />

                    </RadioGroup>

                    <!-- Legacy cancel button — hidden, Java still references it -->
                    <Button
                        android:id="@+id/btnCancel"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- Legacy goToLogin TextView — hidden, new regLoginLink replaces it visually -->
                    <TextView
                        android:id="@+id/goToLogin"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</FrameLayout>