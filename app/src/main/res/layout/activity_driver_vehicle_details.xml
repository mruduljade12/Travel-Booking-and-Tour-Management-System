<?xml version="1.0" encoding="utf-8"?>
<!--
    SmartTour360 Driver App - Vehicle Details Screen
    Header | Vehicle Info Card | Documents Card
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_veh_screen"
    tools:context=".driver.driver_activities.DriverVehicleDetailsActivity">

    <!-- ══ HEADER: back + title ══ -->
    <LinearLayout
        android:id="@+id/ll_veh_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_veh_back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:contentDescription="@string/cd_back_arrow"
            android:focusable="true"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/veh_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/veh_screen_title"
            android:textColor="@color/veh_title"
            android:textSize="@dimen/veh_title_size"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ══ SCROLLABLE CONTENT ══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:fillViewport="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_veh_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══ VEHICLE INFO CARD ══ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/veh_card_bg"
                app:cardCornerRadius="@dimen/veh_card_corner"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Top row: Vehicle image + Car Model + Reg No -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Vehicle image box -->
                        <FrameLayout
                            android:layout_width="@dimen/veh_vehicle_image_size"
                            android:layout_height="@dimen/veh_vehicle_image_size"
                            android:background="@drawable/bg_veh_image_container">

                            <ImageView
                                android:id="@+id/iv_vehicle_image"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_veh_image"
                                android:padding="8dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_vehicle_suv" />

                        </FrameLayout>

                        <!-- Right: Car Model + Reg No -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Car Model -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/veh_lbl_car_model"
                                android:textColor="@color/veh_label"
                                android:textSize="@dimen/veh_label_size" />

                            <TextView
                                android:id="@+id/tv_car_model"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="14dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/veh_val_car_model"
                                android:textColor="@color/veh_value"
                                android:textSize="@dimen/veh_value_size"
                                android:textStyle="bold" />

                            <!-- Registration No. -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/veh_lbl_reg_no"
                                android:textColor="@color/veh_label"
                                android:textSize="@dimen/veh_label_size" />

                            <TextView
                                android:id="@+id/tv_reg_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/veh_val_reg_no"
                                android:textColor="@color/veh_value"
                                android:textSize="@dimen/veh_value_size"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/veh_divider" />

                    <!-- Bottom row: Vehicle Type + Seats -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Vehicle Type -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/veh_lbl_type"
                                android:textColor="@color/veh_label"
                                android:textSize="@dimen/veh_label_size" />

                            <TextView
                                android:id="@+id/tv_vehicle_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/veh_val_type"
                                android:textColor="@color/veh_value"
                                android:textSize="@dimen/veh_value_size"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Seats -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/veh_lbl_seats"
                                android:textColor="@color/veh_label"
                                android:textSize="@dimen/veh_label_size" />

                            <TextView
                                android:id="@+id/tv_seats"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/veh_val_seats"
                                android:textColor="@color/veh_value"
                                android:textSize="@dimen/veh_value_size"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ DOCUMENTS SECTION TITLE ══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/veh_section_documents"
                android:textColor="@color/veh_section_title"
                android:textSize="@dimen/veh_section_title_size"
                android:textStyle="bold" />

            <!-- ══ DOCUMENTS CARD ══ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/veh_card_bg"
                app:cardCornerRadius="@dimen/veh_card_corner"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <!-- RC Book Row -->
                    <LinearLayout
                        android:id="@+id/row_rc_book"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/veh_doc_row_height"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Blue rounded-square icon -->
                        <FrameLayout
                            android:layout_width="@dimen/veh_doc_icon_size"
                            android:layout_height="@dimen/veh_doc_icon_size"
                            android:background="@drawable/bg_veh_doc_icon">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/cd_veh_doc_icon"
                                android:src="@drawable/ic_document"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/veh_doc_rc"
                            android:textColor="@color/veh_doc_text"
                            android:textSize="@dimen/veh_doc_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_veh_verified"
                            android:paddingStart="14dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="5dp"
                            android:text="@string/veh_status_verified"
                            android:textColor="@color/veh_verified_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/veh_divider"/>

                    <!-- Driving License Row -->
                    <LinearLayout
                        android:id="@+id/row_driving_license"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/veh_doc_row_height"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/veh_doc_icon_size"
                            android:layout_height="@dimen/veh_doc_icon_size"
                            android:background="@drawable/bg_veh_doc_icon">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/cd_veh_doc_icon"
                                android:src="@drawable/ic_document"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/veh_doc_license"
                            android:textColor="@color/veh_doc_text"
                            android:textSize="@dimen/veh_doc_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_veh_verified"
                            android:paddingStart="14dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="5dp"
                            android:text="@string/veh_status_verified"
                            android:textColor="@color/veh_verified_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" />

                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/veh_divider"/>

                    <!-- Insurance Row -->
                    <LinearLayout
                        android:id="@+id/row_insurance"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/veh_doc_row_height"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/veh_doc_icon_size"
                            android:layout_height="@dimen/veh_doc_icon_size"
                            android:background="@drawable/bg_veh_doc_icon">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/cd_veh_doc_icon"
                                android:src="@drawable/ic_document"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/veh_doc_insurance"
                            android:textColor="@color/veh_doc_text"
                            android:textSize="@dimen/veh_doc_text_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_veh_verified"
                            android:paddingStart="14dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="5dp"
                            android:text="@string/veh_status_verified"
                            android:textColor="@color/veh_verified_text"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>