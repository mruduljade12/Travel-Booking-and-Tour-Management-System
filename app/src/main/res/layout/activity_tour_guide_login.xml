<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_screen_bg"
    tools:context=".tour_guide.tour_guide_activities.TourGuideLoginActivity">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tvGuideLoginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Tour Guide Login"
        android:textColor="@color/white"
        android:textSize="45sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Guide Badge ID / Username Input Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardGuideUsername"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvGuideLoginTitle">

        <EditText
            android:id="@+id/etGuideUsername"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/input_text_shape_login"
            android:ems="10"
            android:hint="Guide License / Username"
            android:inputType="text"
            android:paddingStart="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/text_hint"
            android:textSize="22sp" />
    </androidx.cardview.widget.CardView>

    <!-- Guide Password Input Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardGuidePassword"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardGuideUsername">

        <EditText
            android:id="@+id/etGuidePassword"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/input_text_shape_login"
            android:ems="10"
            android:hint="@string/password"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/text_hint"
            android:textSize="22sp" />
    </androidx.cardview.widget.CardView>

    <!-- Login & Cancel Buttons -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGuideLogin"
        android:layout_width="160dp"
        android:layout_height="60dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/login_btn_shape"
        android:text="@string/login"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintEnd_toStartOf="@+id/btnGuideCancel"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardGuidePassword" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGuideCancel"
        android:layout_width="160dp"
        android:layout_height="60dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/login_btn_shape"
        android:text="@string/cancel"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btnGuideLogin"
        app:layout_constraintTop_toBottomOf="@+id/cardGuidePassword" />

    <!-- Register Navigation Link -->
    <TextView
        android:id="@+id/tvGuideRegisterLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Guide? Register Here"
        android:textColor="@color/link_color"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnGuideLogin" />

</androidx.constraintlayout.widget.ConstraintLayout>