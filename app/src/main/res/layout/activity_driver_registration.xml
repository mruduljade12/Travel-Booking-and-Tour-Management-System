<?xml version="1.0" encoding="utf-8"?>
<!--
    SmartTour360 Driver App — Screen 3: Driver Register
    Layout: NestedScrollView → ConstraintLayout
    Consistent with Screen 1 (Splash) and Screen 2 (Login) visual language.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".driver.driver_activities.DriverRegistrationActivity"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ── LAYER 1: Full-screen scenic background ── -->
        <ImageView
            android:id="@+id/iv_reg_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/cd_splash_bg"
            android:scaleType="centerCrop"
            android:src="@drawable/splash_screen_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ══════════════════════════════════════════
             BRAND SECTION — logo + SmartTour360 + tagline
             (identical composition to Screen 2)
        ══════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/ll_reg_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_reg_logo"
                android:layout_width="@dimen/login_logo_size"
                android:layout_height="@dimen/login_logo_size"
                android:contentDescription="@string/cd_brand_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/tour_travel_logo" />

            <TextView
                android:id="@+id/tv_reg_brand_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/smarttour360"
                android:textColor="@color/driver_splash_brand_text"
                android:textSize="@dimen/login_brand_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_reg_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.02"
                android:text="@string/driver_splash_tagline"
                android:textColor="@color/driver_splash_subtitle_text"
                android:textSize="@dimen/login_tagline_text_size" />

        </LinearLayout>

        <!-- ══════════════════════════════════════════
             SCREEN TITLE — "Driver Register"
        ══════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tv_reg_screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/driver_register_title"
            android:textColor="@color/login_screen_title"
            android:textSize="@dimen/login_title_text_size"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_reg_brand" />

        <!-- ══════════════════════════════════════════
             REGISTRATION CARD
        ══════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_register"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/login_card_margin_h"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/login_card_margin_h"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/login_card_bg"
            app:cardCornerRadius="@dimen/login_card_corner"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_reg_screen_title">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/login_card_padding">

                <!-- ── FULL NAME FIELD ── -->
                <LinearLayout
                    android:id="@+id/ll_name_field"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/login_input_height"
                    android:background="@drawable/bg_login_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="@dimen/login_input_icon_size"
                        android:layout_height="@dimen/login_input_icon_size"
                        android:contentDescription="@string/cd_person_icon"
                        android:src="@drawable/ic_user"
                        app:tint="@color/login_input_icon" />

                    <EditText
                        android:id="@+id/et_reg_full_name"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/hint_full_name"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="@color/login_input_hint"
                        android:textSize="@dimen/login_input_text_size" />

                </LinearLayout>

                <!-- ── EMAIL / MOBILE FIELD ── -->
                <LinearLayout
                    android:id="@+id/ll_reg_email_field"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/login_input_height"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="@dimen/login_input_icon_size"
                        android:layout_height="@dimen/login_input_icon_size"
                        android:contentDescription="@string/cd_email_icon"
                        android:src="@drawable/ic_email"
                        app:tint="@color/login_input_icon" />

                    <EditText
                        android:id="@+id/et_reg_email"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/hint_email_mobile"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="@color/login_input_hint"
                        android:textSize="@dimen/login_input_text_size" />

                </LinearLayout>

                <!-- ── PASSWORD FIELD ── -->
                <LinearLayout
                    android:id="@+id/ll_reg_password_field"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/login_input_height"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="@dimen/login_input_icon_size"
                        android:layout_height="@dimen/login_input_icon_size"
                        android:contentDescription="@string/cd_lock_icon"
                        android:src="@drawable/ic_password"
                        app:tint="@color/login_input_icon" />

                    <EditText
                        android:id="@+id/et_reg_password"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/hint_password"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="@color/login_input_hint"
                        android:textSize="@dimen/login_input_text_size" />

                    <ImageView
                        android:id="@+id/iv_toggle_reg_password"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:clickable="true"
                        android:contentDescription="@string/cd_visibility_icon"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/ic_visibility_off" />

                </LinearLayout>

                <!-- ── CONFIRM PASSWORD FIELD ── -->
                <LinearLayout
                    android:id="@+id/ll_reg_confirm_field"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/login_input_height"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="@dimen/login_input_icon_size"
                        android:layout_height="@dimen/login_input_icon_size"
                        android:contentDescription="@string/cd_lock_icon"
                        android:src="@drawable/ic_password"
                        app:tint="@color/login_input_icon" />

                    <EditText
                        android:id="@+id/et_reg_confirm_password"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/hint_confirm_password"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="@color/login_input_hint"
                        android:textSize="@dimen/login_input_text_size" />

                    <ImageView
                        android:id="@+id/iv_toggle_confirm_password"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:clickable="true"
                        android:contentDescription="@string/cd_visibility_icon"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/ic_visibility_off" />

                </LinearLayout>

                <!-- ── REGISTER BUTTON ── -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_register"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/login_btn_height"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_driver_splash_cta"
                    android:elevation="4dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_register_now"
                    android:textColor="@color/white"
                    android:textSize="@dimen/login_btn_text_size"
                    android:textStyle="bold" />

                <!-- ── ALREADY HAVE AN ACCOUNT? LOGIN ── -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_already_account"
                        android:textColor="@color/login_register_label"
                        android:textSize="@dimen/login_bottom_text_size" />

                    <TextView
                        android:id="@+id/tv_reg_login_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:text="@string/lbl_login_link"
                        android:textColor="@color/login_register_link"
                        android:textSize="@dimen/login_bottom_text_size"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>