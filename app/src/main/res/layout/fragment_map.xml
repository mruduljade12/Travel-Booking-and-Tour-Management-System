<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_map.xml  —  SmartTour360 Live Tracking Screen
    ═══════════════════════════════════════════════════════
    NO Google Maps API. NO internet. Fully offline Canvas map.
    Layout: ConstraintLayout chain — header → tour card → map → driver card
    All IDs preserved from previous version.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nav_header_bg"
    tools:context=".user.user_fragments.MapFragment">

    <!-- ══════════════════════════
         HEADER  —  Live Tracking
         ══════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navHeader"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:background="@drawable/nav_header_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back arrow -->
        <ImageView
            android:id="@+id/navBackBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="Back"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:tint="#123B70"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Map View pill button -->
        <LinearLayout
            android:id="@+id/navMapViewBtn"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/nav_mapview_btn"
            android:elevation="3dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_map"
                android:contentDescription="@null"
                android:tint="#087FF5"
                android:layout_marginEnd="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Map View"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#087FF5" />

        </LinearLayout>

        <!-- Title + subtitle -->
        <LinearLayout
            android:id="@+id/navTitleGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/navBackBtn"
            app:layout_constraintEnd_toStartOf="@id/navMapViewBtn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Tracking"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#123B70"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goa Beach Tour"
                android:textSize="12sp"
                android:textColor="#6C86A8" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══════════════════════════
         TOUR SUMMARY CARD
         ══════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/navTourCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Circular Goa thumbnail -->
            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_goa"
                android:contentDescription="Tour thumbnail"
                android:background="@drawable/nav_thumb_circle" />

            <!-- Tour info column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Goa Beach Tour"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#123B70" />

                <!-- Duration · Price -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_people"
                        android:contentDescription="@null"
                        android:tint="#6C86A8"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 Days"
                        android:textSize="12sp"
                        android:textColor="#6C86A8" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="10dp"
                        android:background="#D0E4F0"
                        android:layout_marginStart="7dp"
                        android:layout_marginEnd="7dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#8377;15,000"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#087FF5" />

                </LinearLayout>

                <!-- Dates -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_calendar"
                        android:contentDescription="@null"
                        android:tint="#6C86A8"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 May 2025 \u2013 15 May 2025"
                        android:textSize="11sp"
                        android:textColor="#6C86A8" />

                </LinearLayout>

            </LinearLayout>

            <!-- On Tour status badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/nav_status_badge"
                android:layout_marginStart="8dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/nav_status_dot"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="On Tour"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1FA971" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ══════════════════════════════════════════════════
         MAP AREA  — fills space between tour card and driver card
         GoapMapView draws Goa region entirely on Canvas.
         ══════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/navMapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        app:layout_constraintTop_toBottomOf="@id/navTourCard"
        app:layout_constraintBottom_toTopOf="@id/navDriverCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Canvas-drawn Goa map — NO Google Maps, NO internet -->
        <com.mrudul.tourandtravel.user.user_fragments.GoapMapView
            android:id="@+id/navGoapMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Goa region static map" />

        <!-- Map controls — right edge -->
        <LinearLayout
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:elevation="5dp">

            <!-- Recenter / My Location -->
            <FrameLayout
                android:id="@+id/navBtnMyLocation"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/nav_map_control_bg"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_address"
                    android:contentDescription="Recenter map"
                    android:tint="#087FF5" />

            </FrameLayout>

            <!-- Zoom In -->
            <FrameLayout
                android:id="@+id/navBtnZoomIn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/nav_map_control_bg"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#087FF5" />

            </FrameLayout>

            <!-- Zoom Out -->
            <FrameLayout
                android:id="@+id/navBtnZoomOut"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/nav_map_control_bg"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="&#8722;"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#087FF5" />

            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- ══════════════════════════════════════════════════
         DRIVER INFO CARD + START NAVIGATION
         Anchored to bottom via constraint chain.
         ══════════════════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/navDriverCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- Driver info row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Driver photo -->
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/nav_driver_img_bg">

                    <ImageView
                        android:id="@+id/navDriverPhoto"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        android:contentDescription="Driver photo"
                        android:background="@drawable/nav_driver_img_bg" />

                </FrameLayout>

                <!-- Driver details -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Driver"
                        android:textSize="11sp"
                        android:textColor="#9AB5D0" />

                    <TextView
                        android:id="@+id/navDriverName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sanika Patil"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#123B70" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="1dp">

                        <TextView
                            android:id="@+id/navVehicleNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MH-14-CD-5678"
                            android:textSize="11sp"
                            android:textColor="#6C86A8" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:background="#D0E4F0"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/navVehicleType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tempo Traveller"
                            android:textSize="11sp"
                            android:textColor="#6C86A8" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Call + Navigate buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/navPhoneBtn"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/nav_action_btn"
                        android:elevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="10dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_phone"
                            android:contentDescription="Call driver"
                            android:tint="#087FF5" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/navSendBtn"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/nav_action_btn"
                        android:elevation="2dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_send"
                            android:contentDescription="Navigate"
                            android:tint="#087FF5" />

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Start Navigation — AppCompatButton respects android:background in Material3 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/navStartBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Start Navigation"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/nav_start_btn"
                android:stateListAnimator="@null"
                android:drawableStart="@drawable/ic_send"
                android:drawableTint="#FFFFFF"
                android:drawablePadding="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>