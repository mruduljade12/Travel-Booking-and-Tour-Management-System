<?xml version="1.0" encoding="utf-8"?>
<!--
    SmartTour360 Driver App — Navigate to Pickup Screen
    Structure:
      ConstraintLayout
        ├── Header Card (back + title)
        ├── Map area (Google MapView fills remaining space)
        │     ├── "Your location" marker overlay
        │     └── "Customer pickup" marker overlay
        └── Bottom Panel (drag handle + location info + Start Navigation button)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nav_bg"
    tools:context=".driver.driver_activities.NavigateToPickupActivity">

    <!-- ══════════════════════════════════════
         HEADER
    ══════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_nav_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/iv_nav_back"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:clickable="true"
                android:contentDescription="@string/cd_back_arrow"
                android:focusable="true"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/nav_header_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/nav_screen_title"
                android:textColor="@color/nav_header_title"
                android:textSize="@dimen/nav_header_title_size"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ══════════════════════════════════════
         BOTTOM PANEL (constrained bottom)
         Declared BEFORE map so the map can
         constrain its bottom to this panel.
    ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/ll_nav_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Drag handle -->
        <View
            android:layout_width="@dimen/nav_drag_handle_width"
            android:layout_height="@dimen/nav_drag_handle_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_drag_handle" />

        <!-- Location info row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Green circle icon -->
            <FrameLayout
                android:layout_width="@dimen/nav_panel_icon_size"
                android:layout_height="@dimen/nav_panel_icon_size"
                android:background="@drawable/bg_circle_green">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_location_pin_panel" />

            </FrameLayout>

            <!-- Labels -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_panel_label"
                    android:textColor="@color/nav_panel_label"
                    android:textSize="@dimen/nav_panel_label_size" />

                <TextView
                    android:id="@+id/tv_nav_pickup_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Pune Airport"
                    android:textColor="@color/nav_panel_title"
                    android:textSize="@dimen/nav_panel_title_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_nav_pickup_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lonavala, Maharashtra"
                    android:textColor="@color/nav_panel_subtitle"
                    android:textSize="@dimen/nav_panel_subtitle_size" />

            </LinearLayout>

            <!-- Chevron arrow -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right" />

        </LinearLayout>

        <!-- Start Navigation button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_start_navigation"
            android:layout_width="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_height="@dimen/nav_btn_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_start_navigation"
            android:drawableEnd="@drawable/ic_arrow_right_white"
            android:drawablePadding="8dp"
            android:elevation="4dp"
            android:stateListAnimator="@null"
            android:text="@string/nav_btn_start"
            android:textColor="@color/white"
            android:textSize="@dimen/nav_btn_text_size"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ══════════════════════════════════════
         MAP AREA
         Sits between header and bottom panel.
         Google MapFragment fills this container.
         Overlay markers are drawn on top.
    ══════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/fl_map_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_nav_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_nav_header">

        <!-- Google Map fragment host -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ── "Your location" marker overlay ── -->
        <LinearLayout
            android:id="@+id/ll_your_location_marker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="60dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Blue dot -->
            <View
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_circle_blue" />

            <!-- Blue pill label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_your_location_label"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/nav_your_location"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ── "Customer pickup" marker overlay ── -->
        <LinearLayout
            android:id="@+id/ll_customer_pickup_marker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="30dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Green pill label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_customer_pickup_label"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="@string/nav_customer_pickup"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Green pin icon -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_location_pin_green" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>