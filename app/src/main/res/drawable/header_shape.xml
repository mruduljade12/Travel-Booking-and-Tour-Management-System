<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Modern linear gradient with refined teal/cyan tones -->
    <gradient
        android:angle="270"
        android:startColor="#7FA9B0"
        android:centerColor="#AFCFD0"
        android:endColor="#D6E8E8"
        android:type="linear" />

    <!-- Rounded bottom corners for a smooth transition into content -->
    <corners
        android:bottomLeftRadius="20dp"
        android:bottomRightRadius="20dp"
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp" />

</shape>