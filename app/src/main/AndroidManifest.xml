            android:name=".user_activities.ChooseRole"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".user_activities.UserRegisteration"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".driver_activities.DriverMainPage"
