            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".tour_guide_activities.TourGuidePage"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".driver_activities.DriverLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".tour_guide_activities.TourGuideLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>